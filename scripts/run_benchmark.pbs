#!/bin/bash
# Job name:
#PBS -N Guardrail_benchmarking
# Output files:
#PBS -o runtime.out
# Error files
#PBS -e runtime.err
# Queue name
#PBS -q shortGPUQ
# Set the maximum wall time
#PBS -l walltime=07:58:00
# Set the memory cpus and resources
#PBS -l select=1:ncpus=28:ngpus=1:gpu_type=H100:mem=256gb

# Load modules
source envs/llm-env/bin/activate
# Select the working directory
cd "$PBS_O_WORKDIR" # go to the directory where qsub was run # Compile and run

mkdir -p logs # Create logs folder for live checking of job

echo "Start of PBS" &> logs/runtime.log
models=("LlamaGuard8B" "WildGuard7B" "LlamaGuard1B" "GraniteGuardian2B" "ShieldGemma2B")

for model in "${models[@]}"; do
  python3 -u src/main.py $INPUT $model >> logs/runtime.log 2>&1
done

#python3 -u src/main.py $INPUT LlamaGuard8B &> logs/runtime.log

echo "End of PBS" >> logs/runtime.log
